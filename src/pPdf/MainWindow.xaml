<Window x:Class="pPdf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:pPdf.Views"
        xmlns:viewer="clr-namespace:pPdf.Viewer"
        xmlns:pdf="clr-namespace:pPdf.Pdf"
        Icon="Assets/pPdf.ico" Title="pPdf" Width="1180" Height="820" MinWidth="860" MinHeight="480"
        AllowDrop="True" Drop="OnWindowDrop" DragOver="OnWindowDragOver"
        Closing="OnClosing" Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== main toolbar ============================== -->
        <Border x:Name="MainToolbar" Grid.Row="0" Background="{DynamicResource BarBackgroundBrush}" BorderBrush="{DynamicResource BarBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ThemeButton" Style="{StaticResource ToolButton}" Content="&#xE793;" ToolTip="Theme: light / dark / system" Click="OnThemeClick" />
                    <Button x:Name="MoreButton" Style="{StaticResource ToolButton}" Content="&#xE712;" ToolTip="More" Click="OnMoreClick" />
                </StackPanel>

                <WrapPanel Orientation="Horizontal" ItemHeight="36" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Content="&#xE8E5;" ToolTip="Open (Ctrl+O)" Click="OnOpenClick" />
                    <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" Content="&#xE74E;" ToolTip="Save a copy with the annotations (Ctrl+S)" Click="OnSaveClick" />
                    <Button x:Name="PrintButton" Style="{StaticResource ToolButton}" Content="&#xE749;" ToolTip="Print (Ctrl+P)" Click="OnPrintClick" />
                    <Border Style="{StaticResource ToolSeparator}" />

                    <ToggleButton x:Name="SidebarToggle" Style="{StaticResource ToolToggle}" Content="&#xE700;" ToolTip="Pages and outline (F4)" Click="OnSidebarToggle" />
                    <Border Style="{StaticResource ToolSeparator}" />

                    <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Content="&#xE72B;" ToolTip="Back to where you were (Alt+Left)" Click="OnBack" />
                    <Button x:Name="ForwardButton" Style="{StaticResource ToolButton}" Content="&#xE72A;" ToolTip="Forward (Alt+Right)" Click="OnForward" />
                    <Button x:Name="PrevButton" Style="{StaticResource ToolButton}" Content="&#xE70E;" ToolTip="Previous page" Click="OnPrevPage" />
                    <TextBox x:Name="PageBox" Width="48" HorizontalContentAlignment="Center" VerticalAlignment="Center" Margin="2,0"
                             ToolTip="Go to page" KeyDown="OnPageBoxKeyDown" GotKeyboardFocus="OnBoxGotFocus" />
                    <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Margin="2,0,6,0" Foreground="{DynamicResource SubtleTextBrush}" Text="/ 0" />
                    <Button x:Name="NextButton" Style="{StaticResource ToolButton}" Content="&#xE70D;" ToolTip="Next page" Click="OnNextPage" />
                    <Border Style="{StaticResource ToolSeparator}" />

                    <Button Style="{StaticResource ToolButton}" Content="&#xE71F;" ToolTip="Zoom out (Ctrl+-)" Click="OnZoomOut" />
                    <ComboBox x:Name="ZoomBox" Width="108" IsEditable="True" VerticalAlignment="Center" Margin="2,0"
                              ToolTip="Zoom" KeyDown="OnZoomBoxKeyDown" SelectionChanged="OnZoomSelectionChanged" GotKeyboardFocus="OnBoxGotFocus" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE8A3;" ToolTip="Zoom in (Ctrl++)" Click="OnZoomIn" />
                    <Border Style="{StaticResource ToolSeparator}" />

                    <Button x:Name="LayoutButton" Style="{StaticResource ToolButton}" Content="&#xE8A9;" ToolTip="Page layout" Click="OnLayoutClick" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE7AD;" ToolTip="Rotate clockwise (Ctrl+R)" Click="OnRotateRight" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE7AD;" ToolTip="Rotate counter-clockwise (Ctrl+Shift+R)" Click="OnRotateLeft" RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Button.RenderTransform>
                    </Button>
                    <Border Style="{StaticResource ToolSeparator}" />

                    <ToggleButton x:Name="SelectToolButton" Style="{StaticResource ToolToggle}" Content="&#xE933;" ToolTip="Select text; drag the empty page to scroll it" Click="OnSelectTool" />
                    <ToggleButton x:Name="HandToolButton" Style="{StaticResource ToolToggle}" Content="&#xE7C9;" ToolTip="Hand tool: always drag to scroll, even over text" Click="OnHandTool" />
                    <Border Style="{StaticResource ToolSeparator}" />

                    <ToggleButton x:Name="TextToolButton" Style="{StaticResource ToolToggle}" Content="&#xE8D2;" ToolTip="Add text (T): click on the page" Click="OnTextTool" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE8B9;" ToolTip="Add image (I) - or paste / drop one" Click="OnAddImage" />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button x:Name="HighlightButton" Style="{StaticResource ToolButton}" Content="&#xE7E6;" ToolTip="Highlight the selected text" Click="OnHighlight" />
                    <Button x:Name="UnderlineButton" Style="{StaticResource ToolButton}" Content="&#xE8DC;" ToolTip="Underline the selected text" Click="OnUnderline" />
                    <Button x:Name="StrikeButton" Style="{StaticResource ToolButton}" ToolTip="Strike through the selected text" Click="OnStrike">
                        <TextBlock Text="S" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold" TextDecorations="Strikethrough" />
                    </Button>
                    <views:ColorPickerButton x:Name="MarkupColorButton" Glyph="&#xE790;" Tip="Color of highlights and lines" ValueChanged="OnMarkupColorChanged" />
                    <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Click="OnUndo" />
                    <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" Click="OnRedo" />
                    <Border Style="{StaticResource ToolSeparator}" />

                    <ToggleButton x:Name="FindToggle" Style="{StaticResource ToolToggle}" Content="&#xE721;" ToolTip="Find (Ctrl+F)" Click="OnFindToggle" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ============================== annotation properties ============================== -->
        <Border x:Name="AnnotationBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource BarBackgroundBrush}"
                BorderBrush="{DynamicResource BarBorderBrush}" BorderThickness="0,0,0,1" Padding="10,4">
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="TextFormatPanel" Orientation="Horizontal">
                    <ComboBox x:Name="FontBox" Width="170" VerticalAlignment="Center" ToolTip="Font" SelectionChanged="OnFontChanged" />
                    <ComboBox x:Name="SizeBox" Width="76" IsEditable="True" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Font size (points)"
                              KeyDown="OnSizeKeyDown" SelectionChanged="OnSizeChanged" GotKeyboardFocus="OnBoxGotFocus" />
                    <ToggleButton x:Name="BoldToggle" Style="{StaticResource ToolToggleText}" Content="B" FontWeight="Bold" Margin="8,0,1,0" ToolTip="Bold" Click="OnBoldClick" />
                    <ToggleButton x:Name="ItalicToggle" Style="{StaticResource ToolToggleText}" Content="I" FontStyle="Italic" ToolTip="Italic" Click="OnItalicClick" />
                    <views:ColorPickerButton x:Name="TextColorButton" Glyph="&#xE8D3;" Tip="Text color" ValueChanged="OnTextColorChanged" />
                    <views:ColorPickerButton x:Name="FillColorButton" Glyph="&#xE790;" Tip="Background fill" AllowNone="True" ValueChanged="OnFillColorChanged" />
                </StackPanel>
                <TextBlock x:Name="MarkupHint" Text="Marked text: use the highlight / underline / strike buttons or the color to change it" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="2,0" Visibility="Collapsed" />
                <TextBlock x:Name="ImageHint" Text="Drag to move, drag the handles to resize (Ctrl for free proportions)"
                           Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="2,0" Visibility="Collapsed" />
                <Border Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Content="&#xE74D;" ToolTip="Delete annotation (Del)" Click="OnDeleteAnnotation" />
            </StackPanel>
        </Border>

        <!-- ============================== find bar ============================== -->
        <Border x:Name="FindBar" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource BarBackgroundBrush}"
                BorderBrush="{DynamicResource BarBorderBrush}" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="FindBox" Width="280" VerticalAlignment="Center" TextChanged="OnFindTextChanged" KeyDown="OnFindKeyDown" />
                <TextBlock x:Name="FindStatus" Margin="10,0,6,0" MinWidth="86" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                <Button Style="{StaticResource ToolButton}" Content="&#xE70E;" ToolTip="Previous match (Shift+Enter)" Click="OnFindPrev" />
                <Button Style="{StaticResource ToolButton}" Content="&#xE70D;" ToolTip="Next match (Enter)" Click="OnFindNext" />
                <ToggleButton x:Name="MatchCaseToggle" Style="{StaticResource ToolToggleText}" Content="Aa" ToolTip="Match case" Click="OnFindOptionChanged" />
                <ToggleButton x:Name="WholeWordToggle" Style="{StaticResource ToolToggleText}" Content="ab" ToolTip="Whole words only" Click="OnFindOptionChanged" />
                <Button Style="{StaticResource ToolButton}" Content="&#xE711;" ToolTip="Close (Esc)" Click="OnFindClose" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ============================== content ============================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="210" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- sidebar: thumbnails / outline -->
            <Grid x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource BarBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6">
                    <RadioButton x:Name="ThumbTab" GroupName="side" Content="Pages" IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}" Padding="14,4" Margin="2,0" Focusable="False" Checked="OnSideTabChanged" />
                    <RadioButton x:Name="OutlineTab" GroupName="side" Content="Outline" Style="{StaticResource {x:Type ToggleButton}}" Padding="14,4" Margin="2,0" Focusable="False" Checked="OnSideTabChanged" />
                </StackPanel>
                <ListBox x:Name="ThumbList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="OnThumbSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4" Loaded="OnThumbLoaded">
                                <Border Background="White" BorderBrush="#40808080" BorderThickness="1" HorizontalAlignment="Center"
                                        Width="{Binding Width}" Height="{Binding Height}">
                                    <Image Source="{Binding Image}" Stretch="Fill" />
                                </Border>
                                <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TreeView x:Name="OutlineTree" Grid.Row="1" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                          SelectedItemChanged="OnOutlineSelected">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="False" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type pdf:OutlineNode}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Margin="0,2" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <TextBlock x:Name="OutlineEmpty" Grid.Row="1" Text="This document has no outline." Visibility="Collapsed" TextWrapping="Wrap"
                           Margin="14" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
            </Grid>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BarBorderBrush}"
                          ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitterDragCompleted" />

            <!-- the document -->
            <Grid Grid.Column="2" Background="{DynamicResource ViewerBackgroundBrush}">
                <viewer:PdfViewer x:Name="Viewer" />

                <!-- shown while no document is open -->
                <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="56" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                    <TextBlock Text="Open a PDF or an EPUB book to start reading" FontSize="20" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="Press Ctrl+O, or drop a file here." HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                    <Button Content="Open file..." HorizontalAlignment="Center" Margin="0,16,0,0" Padding="22,7" Click="OnOpenClick" />
                    <StackPanel x:Name="RecentPanel" Margin="0,24,0,0" />
                </StackPanel>

                <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="#66000000">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="220" Height="4" />
                        <TextBlock x:Name="BusyText" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="White" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================== status bar ============================== -->
        <Border x:Name="StatusBar" Grid.Row="4" Background="{DynamicResource BarBackgroundBrush}" BorderBrush="{DynamicResource BarBorderBrush}" BorderThickness="0,1,0,0" Padding="10,3">
            <DockPanel>
                <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" />
                <TextBlock x:Name="StatusLeft" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
