<UserControl x:Class="pPdf.Views.ColorPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <ToggleButton x:Name="Toggle" Style="{StaticResource ToolToggle}" Padding="8,4,8,3">
            <StackPanel>
                <TextBlock x:Name="GlyphText" Style="{StaticResource MenuIcon}" FontSize="15" />
                <Border x:Name="Swatch" Height="3" Margin="0,2,0,0" CornerRadius="1" />
            </StackPanel>
        </ToggleButton>
        <Popup x:Name="PalettePopup" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border Margin="6" Padding="10" CornerRadius="8" Background="{DynamicResource BarBackgroundBrush}"
                    BorderBrush="{DynamicResource BarBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <StackPanel>
                    <UniformGrid x:Name="Palette" Columns="8" />
                    <Button x:Name="NoneButton" Content="No color" Margin="0,8,0,0" HorizontalAlignment="Stretch" Focusable="False" Click="OnNoneClick" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource SubtleTextBrush}" />
                        <TextBox x:Name="HexBox" Grid.Column="1" MaxLength="9" KeyDown="OnHexKeyDown" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
