<Window x:Class="pPdf.Views.OrganizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Organize pages" Width="980" Height="700" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="OnKey">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource BarBackgroundBrush}" BorderBrush="{DynamicResource BarBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ExtractButton" Content="Save selected pages..." Padding="12,5" Margin="4,0" Click="OnExtract" ToolTip="Only the selected pages, in a new file" />
                    <Button x:Name="SaveButton" Content="Save as..." Padding="16,5" Margin="4,0" Click="OnSave" ToolTip="All the pages, in this order, in a new file" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal" ItemHeight="36" VerticalAlignment="Center">
                    <Button x:Name="RotateLeftButton" Style="{StaticResource ToolButton}" Content="&#xE7AD;" ToolTip="Turn counter-clockwise (Ctrl+Shift+R)" Click="OnRotateLeft" RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Button.RenderTransform>
                    </Button>
                    <Button x:Name="RotateRightButton" Style="{StaticResource ToolButton}" Content="&#xE7AD;" ToolTip="Turn clockwise (Ctrl+R)" Click="OnRotateRight" />
                    <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Content="&#xE74D;" ToolTip="Leave out (Del)" Click="OnDelete" />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button x:Name="EarlierButton" Style="{StaticResource ToolButton}" Content="&#xE76B;" ToolTip="Move earlier (Ctrl+Left)" Click="OnEarlier" />
                    <Button x:Name="LaterButton" Style="{StaticResource ToolButton}" Content="&#xE76C;" ToolTip="Move later (Ctrl+Right)" Click="OnLater" />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Content="Insert pages from a PDF..." Padding="12,5" Margin="4,0" VerticalAlignment="Center" Click="OnInsert" ToolTip="Adds the pages of other PDF files after the selection (or at the end)" />
                    <CheckBox x:Name="WithAnnotationsBox" Content="With my annotations and form entries" IsChecked="True" VerticalAlignment="Center" Margin="10,0" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <ListBox x:Name="PageList" Grid.Row="1" SelectionMode="Extended" Background="{DynamicResource ViewerBackgroundBrush}" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSelectionChanged" Padding="8">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="150" Margin="4,6">
                        <Grid Width="140" Height="140">
                            <Border Background="White" BorderBrush="#40808080" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.LayoutTransform>
                                    <RotateTransform Angle="{Binding Angle}" />
                                </Border.LayoutTransform>
                                <Image Source="{Binding Thumb}" Width="{Binding ThumbWidth}" Height="{Binding ThumbHeight}" Stretch="Fill" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Label}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Background="{DynamicResource BarBackgroundBrush}" BorderBrush="{DynamicResource BarBorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Border>

        <Border x:Name="BusyOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#66000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="4" />
                <TextBlock Text="Saving..." Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="White" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
