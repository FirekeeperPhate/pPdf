<Application x:Class="pPdf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- set from code by ThemeService (they depend on the effective light / dark theme) -->
            <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#E4E5E8" />
            <SolidColorBrush x:Key="BarBackgroundBrush" Color="#F6F6F7" />
            <SolidColorBrush x:Key="BarBorderBrush" Color="#D9D9DD" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B6B70" />

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="9,6" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            </Style>

            <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="9,6" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            </Style>

            <!-- text-labelled toggle (B / I / Aa ...) -->
            <Style x:Key="ToolToggleText" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinWidth" Value="30" />
            </Style>

            <!-- tooltips and menus inherit the font of the element they belong to: never the icon font of a toolbar button -->
            <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="ToolSeparator" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Margin" Value="6,7" />
                <Setter Property="Background" Value="#40808080" />
            </Style>

            <Style x:Key="MenuIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!-- the box used while editing a text annotation in place: no chrome, it must look like the text itself -->
            <Style x:Key="AnnotationEditBox" TargetType="TextBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#FF2F80ED" BorderThickness="0.8">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
