<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>pPdf</RootNamespace>
    <AssemblyName>pPdf</AssemblyName>
    <ApplicationIcon>Assets/pPdf.ico</ApplicationIcon>
    <Version>0.3.1</Version>
    <Product>pPdf</Product>
    <Authors>Phate</Authors>
    <Copyright>Copyright (C) 2026 Phate</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ThemeMode (the Fluent theme) is still marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Keep the process small: no background GC thread, no dynamic PGO instrumentation, compact the big-object heap more eagerly -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="PDFiumCore" Version="4688.0.0" />
    <PackageReference Include="PDFsharp-wpf" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- only the core of WebView2 is used (the engine runs hidden, to lay out books): leave its WinForms / WPF controls and the XML docs out -->
  <Target Name="LeaveOutWebView2Extras" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.WinForms' Or '%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or ('%(Extension)' == '.xml' And $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Web.WebView2')))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="pPdf.Tests" />
    <Resource Include="Assets/pPdf.ico" />
  </ItemGroup>

</Project>
